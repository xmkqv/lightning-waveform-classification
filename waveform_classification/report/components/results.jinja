{% from "blocks/card.jinja" import card %}
{% from "blocks/table.jinja" import table %}

{# Schema-driven results table: headers and rows from schema #}
{% macro results(headers, rows) %}
{% if rows %}
{% call card() %}
{{ table(headers, rows) }}
{% endcall %}
{% else %}
<p>No results available.</p>
{% endif %}
{% endmacro %}
