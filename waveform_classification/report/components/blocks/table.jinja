{# Generic table with support for HTML cells (safe content) #}
{% macro table(headers, rows) -%}
<table>
    <thead>
        <tr>{% for h in headers %}<th scope="col">{{ h }}</th>{% endfor %}</tr>
    </thead>
    <tbody>
    {% for row in rows %}
        <tr>{% for cell in row %}<td>{{ cell | safe }}</td>{% endfor %}</tr>
    {% endfor %}
    </tbody>
</table>
{%- endmacro %}
